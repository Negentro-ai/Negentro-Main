# ========================================================
# Negentro Content Studio (CMS) — Environment Variables
# ========================================================

# Supabase Project Credentials (https://supabase.com)
# Used for CMS authentication, role management, and content storage
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Integrations
VITE_CALENDLY_URL=https://calendly.com/your-username/30min

# ========================================================
# Resend Custom SMTP Setup (Removes Free Tier Email Limits)
# ========================================================
# To bypass Supabase's 3-emails/hour rate limit and send unlimited
# OTP codes, magic links, and team invitations (3,000 free/month):
#
# 1. Sign up at https://resend.com (free) and create an API Key (re_...)
# 2. In your Supabase Dashboard:
#    Go to: Project Settings -> Authentication -> SMTP Settings
# 3. Toggle "Enable Custom SMTP" to ON and enter:
#    - Sender Email: onboarding@resend.dev (or your verified domain like noreply@negentro.tech)
#    - Sender Name: Negentro Content Studio
#    - Host: smtp.resend.com
#    - Port: 465 (or 587)
#    - Minimum SSL / TLS: SSL (for 465) or TLS (for 587)
#    - Username: resend
#    - Password: [Your Resend API Key, starts with re_]
# 4. Click "Save"
#
# ========================================================
# Supabase SQL Table Setup (Team & Invitations):
# ========================================================
# Run this in Supabase Dashboard -> SQL Editor:
#
# CREATE TABLE IF NOT EXISTS team_invitations (
#   id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
#   email TEXT UNIQUE NOT NULL,
#   role TEXT NOT NULL DEFAULT 'Editor',
#   status TEXT NOT NULL DEFAULT 'Pending',
#   created_at TIMESTAMPTZ DEFAULT NOW()
# );
#
# CREATE TABLE IF NOT EXISTS user_roles (
#   user_id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
#   role TEXT NOT NULL DEFAULT 'Viewer',
#   created_at TIMESTAMPTZ DEFAULT NOW()
# );
#
# ALTER TABLE team_invitations ENABLE ROW LEVEL SECURITY;
# ALTER TABLE user_roles ENABLE ROW LEVEL SECURITY;
#
# CREATE POLICY "Allow authenticated read/write team_invitations"
#   ON team_invitations FOR ALL TO authenticated USING (true) WITH CHECK (true);
#
# CREATE POLICY "Allow authenticated read/write user_roles"
#   ON user_roles FOR ALL TO authenticated USING (true) WITH CHECK (true);
