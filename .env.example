# ============================================================
# PiyAPI Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Core API ─────────────────────────────────────────────────
# PiyAPI live API key (get one at https://piyapi.cloud/login)
PIYAPI_API_KEY=sk_live_your_api_key_here

# API base URL (change for self-hosted / local development)
PIYAPI_BASE_URL=https://api.piyapi.cloud
# PIYAPI_BASE_URL=http://localhost:6767  # Uncomment for local dev

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (with pgvector extension)
DATABASE_URL=postgresql://user:password@localhost:5432/piyapi

# Redis connection string (for caching & rate limiting)
REDIS_URL=redis://localhost:6379

# ── AI Provider Keys (BYOK) ─────────────────────────────────
# At least one AI provider key is required for cognitive engine
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# GOOGLE_AI_API_KEY=your-google-ai-key
# GROQ_API_KEY=gsk_your-groq-key

# ── Authentication ───────────────────────────────────────────
# JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Session secret
SESSION_SECRET=your-session-secret-here

# ── Web App ──────────────────────────────────────────────────
# Next.js public backend URL
NEXT_PUBLIC_BACKEND_URL=https://api.piyapi.cloud
# NEXT_PUBLIC_BACKEND_URL=http://localhost:6767  # Uncomment for local

# Next.js app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── OAuth (optional — for dashboard login) ───────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Connectors (optional — only needed for specific connectors)
# GOOGLE_DRIVE_API_KEY=
# NOTION_API_KEY=
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=

# ── Observability (optional) ────────────────────────────────
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ── Enterprise (optional) ───────────────────────────────────
# SAML_ISSUER=
# SAML_CALLBACK_URL=
# SAML_CERT=
